generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Dilemma {
  id          String   @id @default(cuid()) 
  title       String
  description String   @db.Text
  theme       String   
  options     Option[] 
  createdAt   DateTime @default(now())
}

model Option {
  id               String   @id @default(cuid())
  text             String
  budgetImpact     Float    
  approvalImpact   Int      
  
  dilemma          Dilemma  @relation(fields: [dilemmaId], references: [id])
  dilemmaId        String   
}

model Leaderboard {
  id               String   @id @default(cuid())
  playerName       String
  cityName         String
  monthsSurvived   Int
  finalBudget      Float
  finalApproval    Int
  createdAt        DateTime @default(now())
}